slide "DFS"
    title = []
    subtitle = []
    region = []
    trail = []
    cands = []
    pick = []
    path = []
    panel = []
    caption = []
    labels = NodeLabels([])
    play Set()

    title = Title("Busca em Profundidade:  explora cada caminho até o fim")
    subtitle = Subtitle(title, ["pilha LIFO: escolhe o vizinho mais profundo não visitado (critério: profundidade máxima)"], darken(DFS_COLOR), FS_SUBTITLE)
    play Write(0.5, [&title, &subtitle])

    caption = Caption("Passo 0   •   início no nó " + to_string(START_ID))
    play Fade(0.3, [&caption])

    play RunSearch(&region, &labels, &trail, &cands, &pick, &panel, &path, &caption, DFS_SPEC)

    path = PathMesh(DFS_PATH, DFS_COLOR)
    play Write(0.8, [&path])

    caption = Caption("Caminho: " + short_path(DFS_PATH))
    panel = SummaryPanel(DFS_EXPAND, DFS_PATH, "caminho longo, não o mais curto", DFS_COLOR)
    play [Set([&caption]), Fade(0.5, [&panel])]


# -----------------------------------------------------------------------------
# Comparação
# -----------------------------------------------------------------------------
slide "Comparação"
    title = []
    subtitle = []
    base = []
    endpoints = []
    labels = []
    region = []
    trail = []
    path = []
    panel = []
    caption = []
    play Fade(0.5, [&title, &subtitle, &base, &endpoints, &labels, &region, &trail, &path, &panel, &caption])

    title = Title("Como cada algoritmo buscou na rede")
    subtitle = Subtitle(title, ["verde = melhor valor da coluna"], DARK_GRAY, FS_SUBTITLE)
    play Write(0.5, [&title, &subtitle])

    table = ComparisonTable()
    play Fade(0.5, [&table])

    caption = Footer("O BFS chega no destino com o menor número de passos, enquanto o A* explora muito menos nós que o Dijkstra.")
    play Write(0.6, [&caption])
    
    print ["dijkstra" -> len(DIJK_EXPAND), "astar" -> len(ASTAR_EXPAND), "bfs" -> len(BFS_EXPAND), "dfs" -> len(DFS_EXPAND), "hill" -> len(HILL_EXPAND)]
