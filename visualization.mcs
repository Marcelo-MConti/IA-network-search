# Visualização dos cinco algoritmos de busca implementados
# (Dijkstra, A*, Escalada de Encosta, BFS, DFS) em uma
# rede Pequeno Mundo gerada aleatoriamente. O script
# `visualization-support/generate_data.pl` gera os dados
# necessários do grafo e dos percursos realizados para
# renderizar essa cena.
#
# Para rodar o gerador:
#
#     swipl -q -f scripts/generate_monocurl_graph_data.pl \
#         -g "run(30, 5, 0.15, 31, 0, 29, 'gen/graph.mcl')" -t halt


import std.util
import std.math
import std.color
import std.mesh
import std.anim
import std.scene

# gen.graph15: Hill Climbing fica preso
# START -> 2, GOAL -> 7
#
# gen.graph20: Hill Climbing chega no destino
# START -> 11, GOAL -> 6
import gen.graph20 


background = WHITE


# =============================================================================
# CONSTANTES DO CENÁRIO
# =============================================================================

# Parâmetros usados no gerador (apenas para exibição nos painéis).
let SW_K = 5
let SW_P = 0.15
let START_ID = 11
let GOAL_ID = 6

# --- Quadro -----------------------------------------------------------------
# A altura do quadro é fixa (4 unidades); a largura depende da proporção.
let FRAME_H = 4
let FRAME_W = FRAME_H * aspect_ratio()
let MARGIN = 0.25

# Faixas reservadas: título + subtítulo no topo, legenda embaixo.
let TOP_BAND = 0.7
let BOTTOM_BAND = 0.45

# --- Painel lateral (direita) -----------------------------------------------
let PANEL_W = 2.6
let PANEL_GAP = 0.25
let PANEL_PAD = 0.15
let PANEL_ROW_H = 0.3

# --- Área útil (entre as faixas) e posição do painel ------------------------
let AREA_TOP = FRAME_H / 2 - TOP_BAND
let AREA_BOTTOM = BOTTOM_BAND - FRAME_H / 2
let AREA_H = AREA_TOP - AREA_BOTTOM
let AREA_MID_Y = (AREA_TOP + AREA_BOTTOM) / 2
let PANEL_H = AREA_H
let PANEL_CENTER = [FRAME_W / 2 - MARGIN - PANEL_W / 2, AREA_MID_Y, 0]
let AREA_LEFT = MARGIN - FRAME_W / 2
let AREA_RIGHT = PANEL_CENTER[0] - PANEL_W / 2 - PANEL_GAP

# --- Grafo: a escala e o centro são calculados a partir dos dados -----------
# O grafo é ajustado automaticamente à região à esquerda do painel.
let GRAPH_XS = map(GRAPH_POINTS, |p| p[1])
let GRAPH_YS = map(GRAPH_POINTS, |p| p[2])
let GRAPH_PAD = 1.2

# Centro do grafo em coordenadas locais.
let GRAPH_LOCAL_CENTER = [
    (min_of(GRAPH_XS) + max_of(GRAPH_XS)) / 2,
    (min_of(GRAPH_YS) + max_of(GRAPH_YS)) / 2,
    0
]
let GRAPH_SPAN_X = max_of(GRAPH_XS) - min_of(GRAPH_XS) + 2 * GRAPH_PAD
let GRAPH_SPAN_Y = max_of(GRAPH_YS) - min_of(GRAPH_YS) + 2 * GRAPH_PAD

# Escala para conversão de distâncias do grafo para o cenário.
let GRAPH_UNIT = min((AREA_RIGHT - AREA_LEFT) / GRAPH_SPAN_X, AREA_H / GRAPH_SPAN_Y)
let GRAPH_SCREEN_CENTER = [(AREA_LEFT + AREA_RIGHT) / 2, AREA_MID_Y, 0]

# Raio do nó em coordenadas locais.
let NODE_R_LOCAL = 1.5

# --- Cores ------------------------------------------------------------------
let DIJK_COLOR = CYAN
let ASTAR_COLOR = MAGENTA
let BEST_COLOR = YELLOW
let HILL_COLOR = ORANGE
let BFS_COLOR = BLUE
let DFS_COLOR = PURPLE

let START_COLOR = GREEN
let GOAL_COLOR = RED

let EDGE_COLOR = [0.42, 0.45, 0.5, 1]    # RGBA

# Relaxamento que melhora o g conhecido vs. o que não melhora / ramos abandonados.
let IMPROVE_COLOR = [0.10, 0.62, 0.26, 1]
let STALE_COLOR = [0.55, 0.55, 0.58, 1]

# --- Espessuras de traço ----------------------------------------------------
let EDGE_W = 0.7        # arestas do grafo
let NODE_STROKE = 2
let TREE_W = 2.5        # árvore / trilha da busca
let RELAX_W = 1.5       # arestas de relaxamento (Dijkstra) e guia h (A*)
let HILL_W = 2.5        # arestas candidatas da escalada
let PATH_W = 4.5        # caminho final

# --- Camadas (z_index) ------------------------------------------------------
let Z_EDGE = 0
let Z_TREE = 1
let Z_PATH = 2
let Z_NODE = 3
let Z_EXPLORED = 4
let Z_ENDPOINT = 5
let Z_RING = 6
let Z_PICK = 7
let Z_TAG_BG = 8
let Z_LABEL = 9
let Z_PANEL_BG = 10
let Z_PANEL_HL = 11
let Z_TEXT = 12

# --- Tipografia (um único lugar para ajustar tamanhos) ----------------------
let SANS_FONT = "Fira Sans"
let MONO_FONT = "Fira Mono"

let FS_COVER_TITLE = 1.4
let FS_COVER_SUB = 1.0
let FS_COVER_BODY = 0.8
let FS_AUTHOR = 0.6
let FS_AUTHOR_ID = 0.5

let FS_TITLE = 0.92
let FS_SUBTITLE = 0.56
let FS_CAPTION = 0.56
let FS_NODE_ID = 8       # em coordenadas locais do grafo (efetivo = FS_NODE_ID * GRAPH_UNIT)
let FS_TAG = 0.36        # rótulos g= / f= ao lado dos nós
let FS_PANEL_HEAD = 0.76
let FS_PANEL_SUB = 0.48
let FS_ROW = 0.6
let FS_MARK = 0.48
let FS_TABLE = 0.7
let FS_TABLE_HEAD = 0.64

# Ajuste esse valor para alinhas o texto matemático com o texto usual, se necessário.
let MATH_DROP = 0.11

# Deslocamentos dos rótulos em relação ao centro do nó (coordenadas do cenário).
let TAG_UR = [0.3, 0.12, 0]
let TAG_UL = [-0.3, 0.12, 0]

# Autores (placeholders).
let AUTHORS = [
    ["Lorem ipsum dolor sit amet consec", "12345678"],
    ["Lorem ipsum dolor sit amet consectetu", "12345678"],
    ["Lorem ipsum dolor sit ame", "12345678"],
    ["Lorem ipsum dolor sit amet co", "12345678"],
    ["Lorem ipsum dolor sit", "12345678"]
]

# Registro dos algoritmos: [nome, cor, ordem de expansão, caminho encontrado].
let ALGOS = [
    ["Dijkstra", DIJK_COLOR, DIJK_EXPAND, DIJK_PATH],
    ["A*", ASTAR_COLOR, ASTAR_EXPAND, ASTAR_PATH],
    ["Best-First", BEST_COLOR, BEST_EXPAND, BEST_PATH],
    ["Hill Climbing", HILL_COLOR, HILL_EXPAND, HILL_PATH],
    ["BFS", BFS_COLOR, BFS_EXPAND, BFS_PATH],
    ["DFS", DFS_COLOR, DFS_EXPAND, DFS_PATH]
]


# =============================================================================
# FUNÇÕES AUXILIARES (dados, listas, strings, cores)
# =============================================================================

# Escurece uma cor.
let darken = |c| rgb(c[0] * 0.66, c[1] * 0.66, c[2] * 0.66)

# Cor de texto (preto/branco) com bom contraste sobre o preenchimento `c`.
let ink_on = |c| {
    if (0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2] > 0.62) { return BLACK }
    return WHITE
}

# Cor da camada BFS: camadas posteriores são um pouco mais claras.
let bfs_layer_color = |d| rgb(0.03 + 0.07 * d, 0.16 + 0.15 * d, 0.55 + 0.03 * d)

# Cor de relaxamento: verde quando melhora o melhor g conhecido, cinza caso contrário.
let relax_color = |improved| {
    if (improved == 1) { return IMPROVE_COLOR }
    return STALE_COLOR
}

# Verifica se uma lista possui / NÃO possui um determinado elemento.
let has = |list, x| len(filter(list, |v| v == x)) > 0
let lacks = |list, x| len(filter(list, |v| v == x)) == 0

# Primeiro elemento de uma lista, ou -1 se ela estiver vazia.
let head_or_none = |l| {
    if (len(l) == 0) { return -1 }
    return l[0]
}

# Remove duplicatas mantendo a primeira ocorrência de cada chave `key(item)`.
let dedupe = |items, key| {
    let rec = |self, rest, seen, acc| {
        if (len(rest) == 0) { return acc }
        let k = key(rest[0])
        if (has(seen, k)) {
            return self(self, drop(rest, 1), seen, acc)
        }
        return self(self, drop(rest, 1), seen .. k, acc .. rest[0])
    }
    return rec(rec, items, [], [])
}

# Lista aberta [[id, f], ...] sem nós repetidos (mantém o menor f, que vem primeiro).
let unique_pending = |pending| dedupe(pending, |e| e[0])
let unique_len = |pending| len(unique_pending(pending))
let unique_ids = |ids| dedupe(ids, identity)

# Pares consecutivos de uma sequência de nós: [a, b, c] -> [[a, b], [b, c]].
let Chain = |ids| zip(take(ids, len(ids) - 1), drop(ids, 1))

# Formata um número com uma casa decimal.
let num1 = |x| to_string(round(x * 10) / 10)

# Renderiza uma lista de IDs de nós como "0 → 2 → 6".
let path_str = |p| {
    let rec = |self, rest| {
        if (len(rest) == 0) { return "" }
        if (len(rest) == 1) { return to_string(rest[0]) }
        return to_string(rest[0]) + " → " + self(self, drop(rest, 1))
    }
    return rec(rec, p)
}

# Mantém caminhos longos legíveis: mostra a raiz e os últimos quatro nós.
let short_path = |p| {
    if (len(p) <= 8) { return path_str(p) }
    let head = take(p, 3)
    let tail = take(drop(p, len(p) - 4), 4)
    return path_str(head) + " … " + path_str(tail)
}

# --- Geometria do grafo ---

# Ponto do grafo com ID `id`.
let pt_of = |id| filter(GRAPH_POINTS, |p| p[0] == id)[0]

# Coordenadas locais do nó `id`.
let local = |id| {
    let p = pt_of(id)
    return [p[1], p[2], 0]
}

let graph_origin = [
    GRAPH_SCREEN_CENTER[0] - GRAPH_LOCAL_CENTER[0] * GRAPH_UNIT,
    GRAPH_SCREEN_CENTER[1] - GRAPH_LOCAL_CENTER[1] * GRAPH_UNIT,
    0
]

# Coordenadas locais -> coordenadas do cenário.
let screen = |id| {
    let p = local(id)
    return [graph_origin[0] + GRAPH_UNIT * p[0], graph_origin[1] + GRAPH_UNIT * p[1], 0]
}

# Heurística de A*: distância euclidiana ao destino (coordenadas locais).
let h = |id| norm(local(id) - local(GOAL_ID))

# Peso da aresta entre dois nós (a lista de arestas é não-direcionada).
let weight_of = |a, b|
    filter(GRAPH_EDGES, |e| (e[0] == a and e[1] == b) or (e[0] == b and e[1] == a))[0][2]

# Custo total de um caminho.
let path_cost = |p| sum(map(Chain(p), |pr| weight_of(pr[0], pr[1])))

# Conversão de coordenadas para renderização do cenário.
let embed_graph = operator |target|
    in_space{graph_origin, GRAPH_UNIT * 1r, GRAPH_UNIT * 1u}
    target


# =============================================================================
# BLOCOS DE TEXTO E LAYOUT
# =============================================================================

# Espaçador invisível para usar dentro de Stack/XStack.
let Gap = |size| fill{CLEAR} stroke{CLEAR} Rect(size)

# Texto em fonte sans-serif.
let Sans = |text, sc| Text(text, sc, font: SANS_FONT)

# Fórmula (Typst) em linha.
let MathText = |s, sc| 
    shift{[0,MATH_DROP,0]} Typst("$" + s + "$", sc)

# Reduz uma malha (só se necessário) para que sua largura não passe de `maxw`.
let fit_width = |m, maxw| scale{min(1, maxw / max(mesh_width(m), 0.001))} m

# Texto posicionado por âncora: align = "l" (borda esquerda em x),
# "r" (borda direita em x) ou "c" (centro em x). `y` é o centro vertical.
let TextAt = |str, sc, c, x, y, align, maxw| {
    if (len(str) == 0) { return [] }
    let t = fit_width(Sans(str, sc), maxw)
    var dx = x - mesh_center(t)[0]
    if (align == "l") { dx = x - mesh_left(t)[0] }
    if (align == "r") { dx = x - mesh_right(t)[0] }
    return z_index{Z_TEXT} color{c} shift{[dx, y - mesh_center(t)[1], 0]} t
}

# Intercala `gap` entre os itens de uma lista.
let spaced = |items, gap| {
    let flat = flatten(map(items, |m| [m, gap]))
    return take(flat, len(flat) - 1)
}

# Empilha verticalmente (primeiro item em cima).
let VStack = |items| Stack(items, DOWN)

# Título no topo, centralizado.
let Title = |str| {
    let m = fit_width(Sans(str, FS_TITLE), FRAME_W - 0.6)
    return to_side{UP, 0.2} color{BLACK} center{ORIGIN} m
}

# Aceita texto simples ou meshes (ex.: MathText) em `parts`.
let piece = |p, sc| {
    if (is_string(p)) { return Sans(p, sc) }
    return p
}

# Subtítulo logo abaixo de `anchor`, composto por pedaços lado a lado.
let Subtitle = |anchor, parts, col, sc| {
    let m = fit_width(XStack(map(parts, |p| piece(p, sc))), FRAME_W - 0.6)
    return next_to{anchor, DOWN, 0.12} color{col} center{ORIGIN} m
}

# Legenda no canto inferior esquerdo (alinhada à esquerda, nunca invade o grafo).
let Caption = |str|
    to_corner{DOWN + LEFT, 0.2}
    color{BLACK}
    center{ORIGIN}
    fit_width(Sans(str, FS_CAPTION), FRAME_W - 0.6)

# Legenda do passo atual dos algoritmos.
let StepCaption = |i, rest| Caption("Passo " + to_string(i + 1) + "   •   " + rest)

# Nota centralizada no rodapé.
let Footer = |str|
    to_side{DOWN, 0.2}
    color{BLACK}
    center{ORIGIN}
    fit_width(Sans(str, FS_CAPTION), FRAME_W - 2 * MARGIN)


# =============================================================================
# MESH FACTORIES DO GRAFO (todas em coordenadas locais + embed_graph)
# =============================================================================

# Um conjunto de arestas [[a, b, ...], ...] (sem estilo; quem chama estiliza).
let EdgeSet = |edges|
    embed_graph{}
    block {
        for (e in edges) {
            . Line(local(e[0]), local(e[1]))
        }
    }

# Aresta tracejada entre dois nós. O tracejado é aplicado em coordenadas locais.
let DashedEdge = |a, b, c, w, dash|
    embed_graph{}
    z_index{Z_TREE}
    dashed{dash}
    stroke{c, w}
    Line(local(a), local(b))

# Círculo (sólido) centrado em um nó.
let NodeCircle = |id, r|
    embed_graph{}
    fill{WHITE}
    center{local(id)}
    Circle(r)

# O conjunto de arestas do grafo.
let GraphEdges = || stroke{EDGE_COLOR, EDGE_W} z_index{Z_EDGE} EdgeSet(GRAPH_EDGES)

# Todos os nós do grafo (apenas círculos).
let AllNodes = ||
    z_index{Z_NODE}
    #fill{WHITE}
    stroke{EDGE_COLOR, NODE_STROKE}
    block {
        for (pt in GRAPH_POINTS) {
            . tag{pt[0]} NodeCircle(pt[0], NODE_R_LOCAL)
        }
    }

# Cor do número do nó: branco/preto conforme o preenchimento visível por baixo.
# `inked` = [[id, cor_de_preenchimento], ...] dos nós já explorados.
let ink_for = |id, inked| {
    if (id == START_ID) { return ink_on(START_COLOR) }
    if (id == GOAL_ID) { return ink_on(GOAL_COLOR) }
    let hit = filter(inked, |e| e[0] == id)
    if (len(hit) == 0) { return BLACK }
    return ink_on(hit[0][1])
}

# Números de todos os nós, numa única camada acima de tudo.
# Nós explorados/início/fim recebem cor contrastante com o preenchimento.
let NodeLabels = |inked|
    embed_graph{}
    z_index{Z_LABEL}
    block {
        for (pt in GRAPH_POINTS) {
            . center{local(pt[0])} color{ink_for(pt[0], inked)} Sans(to_string(pt[0]), FS_NODE_ID)
        }
    }

# Um nó explorado, preenchido com a cor do algoritmo.
let ExploredNode = |id, c|
    tag{id}
    z_index{Z_EXPLORED}
    fill{c}
    stroke{darken(c), 1.5}
    NodeCircle(id, NODE_R_LOCAL * 1.15)

# Nó inicial / final (disco colorido; o número vem de NodeLabels).
let Endpoint = |id, c|
    tag{id}
    z_index{Z_ENDPOINT}
    fill{c}
    stroke{darken(c), NODE_STROKE}
    NodeCircle(id, NODE_R_LOCAL * 1.3)

# Anel tracejado em volta de um nó candidato.
let CandidateRing = |id, c|
    embed_graph{}
    tag{id}
    z_index{Z_RING}
    fill{CLEAR}
    stroke{c, 1.75}
    dashed{[0.4, 0.4]}
    center{local(id)}
    Circle(NODE_R_LOCAL * 1.65)

# Vários anéis de uma vez.
let Rings = |ids, col|
    block {
        for (id in ids) {
            . CandidateRing(id, col)
        }
    }

# Marca o nó escolhido no passo: anel cheio e translúcido (o número continua legível).
let PickMark = |id, col|
    tag{id}
    z_index{Z_PICK}
    fill{alpha{0.25} col}
    stroke{col, 3}
    NodeCircle(id, NODE_R_LOCAL * 1.65)

# Marcador cinza tracejado para um nó abandonado após retrocesso (DFS).
let AbandonMark = |id|
    embed_graph{}
    z_index{Z_RING}
    fill{alpha{0.18} STALE_COLOR}
    stroke{STALE_COLOR, 3}
    dashed{[0.16, 0.1]}
    center{local(id)}
    Circle(NODE_R_LOCAL * 1.95)

# Caminho encontrado.
let PathMesh = |path, col|
    embed_graph{}
    z_index{Z_PATH}
    stroke{darken(col), PATH_W}
    Polyline(map(path, local))

# Arestas da árvore/trilha da busca.
let TreeEdges = |edges, col| stroke{col, TREE_W} z_index{Z_TREE} EdgeSet(edges)

# Rótulo curto ao lado de um nó, com um fundo branco translúcido para ficar
# legível sobre arestas e outros nós. `off` é o deslocamento (TAG_UR / TAG_UL).
let NodeTag = |id, str, c, off| {
    let t = center{screen(id) + off} color{c} Sans(str, FS_TAG)
    return [
        z_index{Z_TAG_BG} stroke{CLEAR} fill{alpha{0.9} WHITE} BoundingBox(t, 0.025),
        z_index{Z_LABEL} t
    ]
}


# =============================================================================
# PAINÉIS LATERAIS (um único componente genérico + variações finas)
# =============================================================================

# Painel de tabela com moldura de tamanho fixo (não "pula" entre passos).
#   head, sub : cabeçalho e subcabeçalho
#   info      : linhas de texto extras acima da tabela (lista de strings)
#   rows      : [[célula, célula, ...], ...]
#   cols      : [[deslocamento_x_a_partir_da_borda_esquerda, alinhamento], ...]
#   mark      : texto à direita da 1ª linha ("" = nenhum)
#   hi        : 1 para destacar a 1ª linha
# Linhas além da capacidade viram "+ N mais".
let Panel = |head, sub, info, rows, cols, col, mark, hi| {
    let half_h = PANEL_H / 2
    let left = -PANEL_W / 2
    let inner = PANEL_W - 2 * PANEL_PAD
    let rows_y0 = half_h - 0.9 - len(info) * 0.26
    let slots = to_int(floor((rows_y0 - (PANEL_PAD - half_h)) / PANEL_ROW_H)) + 1
    let shown = take(rows, slots - 1)
    return shift{PANEL_CENTER} block {
        . z_index{Z_PANEL_BG} fill{alpha{0.06} col} stroke{darken(col), 1.2} Rect([PANEL_W, PANEL_H])
        . TextAt(head, FS_PANEL_HEAD, darken(col), 0, half_h - 0.24, "c", inner)
        . TextAt(sub, FS_PANEL_SUB, DARK_GRAY, 0, half_h - 0.5, "c", inner)
        for ([k, line] in enumerate(info)) {
            . TextAt(line, FS_PANEL_SUB + 0.04, BLACK, left + PANEL_PAD, half_h - 0.76 - k * 0.26, "l", inner)
        }
        if (len(rows) == 0) {
            . TextAt("(vazia)", FS_ROW, DARK_GRAY, 0, rows_y0, "c", inner)
        }
        for ([i, row] in enumerate(shown)) {
            let y = rows_y0 - i * PANEL_ROW_H
            var c = BLACK
            if (i == 0 and hi == 1) {
                c = darken(col)
                . z_index{Z_PANEL_HL} fill{alpha{0.2} col} stroke{CLEAR} shift{[0, y, 0]} Rect([inner + 0.1, PANEL_ROW_H - 0.04])
            }
            for ([j, cell] in enumerate(row)) {
                . TextAt(cell, FS_ROW, c, left + cols[j][0], y, cols[j][1], inner)
            }
            if (i == 0 and len(mark) > 0) {
                . TextAt(mark, FS_MARK, darken(col), left + PANEL_W - PANEL_PAD, y, "r", 1.0)
            }
        }
        if (len(rows) > len(shown)) {
            . TextAt("+ " + to_string(len(rows) - len(shown)) + " mais", FS_PANEL_SUB, DARK_GRAY, left + PANEL_PAD, rows_y0 - len(shown) * PANEL_ROW_H, "l", inner)
        }
    }
}

# Esquemas de colunas reutilizáveis.
let COLS_ID = [[0.2, "l"]]
let COLS_SCORE = [[0.2, "l"], [0.8, "l"]]
let COLS_ASTAR = [[0.2, "l"], [0.7, "l"], [1.45, "l"]]
let COLS_SUMMARY = [[PANEL_PAD, "l"], [PANEL_W - PANEL_PAD, "r"]]

# XXX: implementar pop e push corretos usando trans ou algo do tipo

# Lista de IDs (fila BFS, pilha DFS).
let ListPanel = |ids, head, sub, info, mark, col|
    Panel(head, sub, info, map(ids, |id| [to_string(id)]), COLS_ID, col, mark, 1)

# Lista de [id, valor] com um prefixo (g=, w=...): lista aberta do Dijkstra, candidatos da escalada.
let ScoredPanel = |entries, tag, head, sub, mark, col|
    Panel(head, sub, [], map(entries, |e| [to_string(e[0]), tag + "=" + num1(e[1])]), COLS_SCORE, col, mark, 1)

# Lista aberta de A*: mostra f e sua decomposição g + h.
let AstarPanel = |pending, col|
    Panel("Nós a serem visitados", "menor f primeiro  •  f = g + h", [],
          map(unique_pending(pending),
              |e| [to_string(e[0]), "f=" + num1(e[1]), num1(e[1] - h(e[0])) + " + " + num1(h(e[0]))]),
          COLS_ASTAR, col, "", 1)

# Resumo final de um algoritmo.
let SummaryPanel = |expand, path, verdict, col|
    Panel("Resultado", verdict, [],
          [["Explorados", to_string(len(expand))],
           ["Saltos", to_string(len(path) - 1)],
           ["Peso", num1(path_cost(path))]],
          COLS_SUMMARY, col, "", 0)

# Resumo da rede (slide "O grafo").
let GraphInfoPanel = ||
    Panel("Rede", "Pequeno Mundo", [],
          [["Nós", to_string(len(GRAPH_POINTS))],
           ["Arestas", to_string(len(GRAPH_EDGES))],
           ["Vizinhos (K)", to_string(SW_K)],
           ["Reconexão (p)", to_string(SW_P)],
           ["Início", to_string(START_ID)],
           ["Objetivo", to_string(GOAL_ID)]],
          COLS_SUMMARY, GRAY, "", 0)


# =============================================================================
# CENAS TRANSITÓRIAS DE CADA PASSO (sobreposições no grafo)
# =============================================================================

# Dijkstra: rótulo g do nó expandido, anéis na lista aberta e arestas de
# relaxamento (verde = melhora o g conhecido, cinza = não melhora).
let DijkstraOverlay = |cur, cur_g, open, relaxes, col|
    block {
        . NodeTag(cur, "g=" + num1(cur_g), darken(col), TAG_UR)
        . Rings(map(open, |e| e[0]), col)
        for ([nb, w, cand, improved] in relaxes) {
            . DashedEdge(cur, nb, relax_color(improved), RELAX_W, [0.5, 0.5])
            if (improved == 1) {
                . NodeTag(nb, "g=" + num1(cand), darken(relax_color(1)), TAG_UL)
            }
        }
    }

# A*: anéis + rótulos f na lista aberta, e uma guia tracejada (a heurística h)
# do próximo nó a expandir até o objetivo.
let AstarOverlay = |pending, col| {
    let entries = unique_pending(pending)
    return block {
        for ([i, e] in enumerate(entries)) {
            . CandidateRing(e[0], col)
            . NodeTag(e[0], "f=" + num1(e[1]), darken(col), TAG_UR)
            if (i == 0 and not (e[0] == GOAL_ID)) {
                . DashedEdge(e[0], GOAL_ID, col, RELAX_W, [0.5, 0.5])
            }
        }
    }
}

# Best-First: anéis na lista aberta; rótulo h só nos filhos recém-gerados;
# guia tracejada do próximo nó até o objetivo.
let BestOverlay = |open, cands, col|
    block {
        . Rings(map(open, |e| e[0]), col)
        for ([id, hv] in cands) {
            . NodeTag(id, "h=" + num1(hv), darken(col), TAG_UR)
        }
        if (len(open) > 0) {
            if (not (open[0][0] == GOAL_ID)) {
                . DashedEdge(open[0][0], GOAL_ID, col, RELAX_W, [0.5, 0.5])
            }
        }
    }

# Hill Climbing: anéis e arestas candidatas a partir do nó atual.
let HillOverlay = |from, cands, col|
    block {
        . Rings(map(cands, |c| c[0]), col)
        for ([id, w] in cands) {
            . DashedEdge(from, id, col, HILL_W, [0.5, 0.5])
        }
    }

# BFS: anéis em cada nó da fila.
let BFSOverlay = |queue, col| Rings(queue, col)

# DFS: anéis nas cabeças de ramo alternativas e marcas cinzas no ramo
# abandonado por um retrocesso.
let DFSOverlay = |cur_path, heads, back, prev_path, col|
    block {
        . Rings(unique_ids(heads), col)
        if (back == 1) {
            for (id in prev_path) {
                if (lacks(cur_path, id)) {
                    . AbandonMark(id)
                }
            }
        }
    }


# =============================================================================
# ESPECIFICAÇÃO DOS ALGORITMOS
# Cada algoritmo é descrito por uma lista, consumida por RunSearch:
#   [0] ordem de expansão (lista de IDs)
#   [1] cor do algoritmo
#   [2] |i| cor de preenchimento do nó expandido no passo i
#   [3] |i| arestas da árvore/trilha até o passo i  ([[pai, filho], ...])
#   [4] |i| mesh do ramo ativo no passo i (ou [])
#   [5] |i| texto da legenda no passo i
#   [6] |i| sobreposição transitória no grafo
#   [7] |i| painel lateral
#   [8] |i| ID do nó a destacar (ou -1)
# =============================================================================

let DIJK_SPEC = [
    DIJK_EXPAND,
    DIJK_COLOR,
    |i| DIJK_COLOR,
    |i| filter(take(DIJK_PRED, i + 1), |e| len(e) > 0),
    |i| [],
    |i| "expandir " + to_string(DIJK_EXPAND[i]) + " (g=" + num1(DIJK_G[i]) + ")   •   relaxar " + to_string(len(DIJK_RELAX[i])),
    |i| DijkstraOverlay(DIJK_EXPAND[i], DIJK_G[i], DIJK_OPEN[i], DIJK_RELAX[i], DIJK_COLOR),
    |i| ScoredPanel(DIJK_OPEN[i], "g", "Nós a serem visitados", "menor g primeiro", "próximo", DIJK_COLOR),
    |i| DIJK_PICK[i]
]

let ASTAR_SPEC = [
    ASTAR_EXPAND,
    ASTAR_COLOR,
    |i| ASTAR_COLOR,
    |i| Chain(take(ASTAR_EXPAND, i + 1)),
    |i| [],
    |i| "expandir " + to_string(ASTAR_EXPAND[i]) + "   •   lista aberta: " + to_string(unique_len(ASTAR_PENDING[i])),
    |i| AstarOverlay(ASTAR_PENDING[i], ASTAR_COLOR),
    |i| AstarPanel(ASTAR_PENDING[i], ASTAR_COLOR),
    |i| head_or_none(map(ASTAR_PENDING[i], |e| e[0]))
]

let BEST_SPEC = [
    BEST_EXPAND,
    BEST_COLOR,
    |i| BEST_COLOR,
    |i| filter(take(BEST_PRED, i + 1), |e| len(e) > 0),
    |i| [],
    |i| "expandir " + to_string(BEST_STEPS[i][0]) + "   •   novos: " + to_string(len(BEST_STEPS[i][1])) + "   •   lista aberta: " + to_string(len(BEST_PENDING[i])),
    |i| BestOverlay(BEST_PENDING[i], BEST_STEPS[i][1], BEST_COLOR),
    |i| ScoredPanel(BEST_PENDING[i], "h", "Nós a serem visitados", "menor h primeiro", "próximo", BEST_COLOR),
    |i| BEST_STEPS[i][2]
]

let HILL_SPEC = [
    HILL_EXPAND,
    HILL_COLOR,
    |i| HILL_COLOR,
    |i| Chain(take(HILL_EXPAND, i + 1)),
    |i| [],
    |i| "em " + to_string(HILL_STEPS[i][0]) + "   •   candidatos: " + to_string(len(HILL_STEPS[i][1])),
    |i| HillOverlay(HILL_STEPS[i][0], HILL_STEPS[i][1], HILL_COLOR),
    |i| ScoredPanel(sort(HILL_STEPS[i][1], |c| c[1]), "w", "Candidatos", "menor peso de aresta", "mín", HILL_COLOR),
    |i| HILL_STEPS[i][2]
]

let BFS_SPEC = [
    BFS_EXPAND,
    BFS_COLOR,
    |i| bfs_layer_color(BFS_STEPS[i][3]),
    |i| flatten(map(take(BFS_STEPS, i + 1), |s| s[2])),
    |i| [],
    |i| "desenfileirar " + to_string(BFS_STEPS[i][0]) + " (profundidade " + to_string(BFS_STEPS[i][3]) + ")   •   novos: " + to_string(len(BFS_STEPS[i][2])),
    |i| BFSOverlay(BFS_STEPS[i][1], BFS_COLOR),
    |i| ListPanel(BFS_STEPS[i][1], "Fila (FIFO)", "frente → trás", [], "próximo", BFS_COLOR),
    |i| head_or_none(BFS_STEPS[i][1])
]

# DFS: ramo ativo como polilinha e legenda com aviso de retrocesso.
let dfs_path = |i| {
    if (len(DFS_STEPS[i][1]) > 1) { return PathMesh(DFS_STEPS[i][1], DFS_COLOR) }
    return []
}

let dfs_caption = |i| {
    var s = "visitar " + to_string(DFS_STEPS[i][0]) + " (profundidade " + to_string(DFS_STEPS[i][4]) + ")"
    if (DFS_STEPS[i][5] == 1) { s = s + "   •   retroceder" }
    return s
}

let dfs_prev_path = |i| {
    if (i > 0) { return DFS_STEPS[i - 1][1] }
    return []
}

let DFS_SPEC = [
    DFS_EXPAND,
    DFS_COLOR,
    |i| DFS_COLOR,
    |i| flatten(map(take(DFS_STEPS, i + 1), |s| s[3])),
    |i| dfs_path(i),
    |i| dfs_caption(i),
    |i| DFSOverlay(DFS_STEPS[i][1], DFS_STEPS[i][2], DFS_STEPS[i][5], dfs_prev_path(i), DFS_COLOR),
    |i| ListPanel(unique_ids(DFS_STEPS[i][2]), "Pilha (LIFO)", "topo primeiro",
                  ["Profundidade: " + to_string(DFS_STEPS[i][4]), "Ramo: " + short_path(DFS_STEPS[i][1])],
                  "próximo", DFS_COLOR),
    |i| DFS_STEPS[i][0]
]


# =============================================================================
# ANIMAÇÃO PASSO A PASSO (um único executor para os cinco algoritmos)
#
# Para cada passo i (exceto o último, que é o objetivo):
#   1. o nó expandido entra na região explorada e a árvore/trilha cresce;
#      os números dos nós e a legenda são atualizados;
#   2. aparecem a sobreposição (anéis, arestas candidatas), o nó destacado e o
#      painel lateral (o painel faz crossfade para o do passo seguinte);
#   3. a sobreposição some, deixando apenas o estado persistente.
# =============================================================================
let RunSearch = |&region, &labels, &trail, &cands, &pick, &panel, &path, &caption, spec| anim {
    let expand = spec[0]
    let col = spec[1]
    let node_col = spec[2]
    let trail_of = spec[3]
    let path_of = spec[4]
    let caption_of = spec[5]
    let overlay_of = spec[6]
    let panel_of = spec[7]
    let pick_of = spec[8]

    for (i in range(0, len(expand) - 1)) {
        let cur = expand[i]
        if (i > 0) {
            region = [region, ExploredNode(cur, node_col(i))]
        }
        labels = NodeLabels(map(enumerate(take(expand, i + 1)), |p| [p[1], node_col(p[0])]))
        trail = TreeEdges(trail_of(i), col)
        path = path_of(i)
        caption = StepCaption(i, caption_of(i))
        play [
            Grow(0.2, [&region]),
            Grow(0.2, [&trail]),
            Set([&labels, &path, &caption])
        ]

        cands = overlay_of(i)
        panel = panel_of(i)
        
        let nxt = pick_of(i)
        
        if (nxt < 0) {
            pick = []
        } else {
            pick = PickMark(nxt, col)
        }
        
        play Fade(0.25, [&cands, &pick, &panel])
        play Wait(0.5)

        pick = []
        cands = []
        play Fade(0.25, [&cands, &pick])
    }
}


# =============================================================================
# SLIDE: INTRODUÇÃO E TABELA COMPARATIVA (blocos de layout)
# =============================================================================

# Um autor: nome + ID.
let Author = |name, id|
    VStack([
        color{BLACK} Sans(name, FS_AUTHOR),
        color{BLACK} Text("ID: " + id, FS_AUTHOR_ID, MONO_FONT)
    ])

# Autores em linhas de `per_row` colunas.
let AuthorRows = |authors, per_row| {
    let n_rows = to_int(ceil(len(authors) / to_float(per_row)))
    
    let rows = map(
                    range(0, n_rows),
                    |k| {
                        return XStack(
                            spaced(
                                map(
                                    take(drop(authors, k * per_row), per_row),
                                    |a| {
                                        # XXX: hacky but it works
                                        # (nudge author positions)
                                        if (a[0] == "Lorem ipsum dolor sit amet co") {
                                            return [
                                                Gap([1.1, 0]),
                                                Author(a[0], a[1])
                                            ]
                                        } else {
                                            return Author(a[0], a[1])
                                        }
                                    }
                                ), 
                                Gap([0.5, 0.01])
                            )
                        )
                    }
                )

    return VStack(spaced(rows, Gap([0.01, 0.15])))
}

# Colunas da tabela comparativa (posições relativas à largura do quadro).
let TABLE_LEFT = 0.7 - FRAME_W / 2
let TABLE_RIGHT = FRAME_W / 2 - 0.7
let TABLE_TOP = AREA_TOP - 0.2
let TABLE_ROW_H = 0.42
let TABLE_COLS = [
    TABLE_LEFT + 0.4,
    TABLE_RIGHT - 2.6,
    TABLE_RIGHT - 1.3,
    TABLE_RIGHT
]

# Verde quando o valor é o melhor (menor) da coluna.
let metric_color = |v, vals| {
    if (v == min_of(vals)) { return IMPROVE_COLOR }
    return BLACK
}

# Tabela: algoritmo | explorados | saltos | peso. Tudo calculado de ALGOS.
let ComparisonTable = || {
    let counts = map(ALGOS, |a| len(a[2]))
    let hops = map(ALGOS, |a| len(a[3]) - 1)
    let costs = map(ALGOS, |a| path_cost(a[3]))
    return block {
        . TextAt("Algoritmo", FS_TABLE_HEAD, DARK_GRAY, TABLE_COLS[0], TABLE_TOP, "l", 2)
        . TextAt("Explorados", FS_TABLE_HEAD, DARK_GRAY, TABLE_COLS[1], TABLE_TOP, "r", 1.4)
        . TextAt("Saltos", FS_TABLE_HEAD, DARK_GRAY, TABLE_COLS[2], TABLE_TOP, "r", 1.0)
        . TextAt("Peso", FS_TABLE_HEAD, DARK_GRAY, TABLE_COLS[3], TABLE_TOP, "r", 1.0)
        . stroke{LIGHT_GRAY, 1} Line([TABLE_LEFT, TABLE_TOP - 0.2, 0], [TABLE_RIGHT, TABLE_TOP - 0.2, 0])
        for ([i, a] in enumerate(ALGOS)) {
            let y = TABLE_TOP - 0.5 - i * TABLE_ROW_H
            . shift{[TABLE_LEFT + 0.12, y, 0]} fill{a[1]} stroke{darken(a[1])} Square(0.2)
            . TextAt(a[0], FS_TABLE, BLACK, TABLE_COLS[0], y, "l", 2.4)
            . TextAt(to_string(counts[i]), FS_TABLE, metric_color(counts[i], counts), TABLE_COLS[1], y, "r", 1.4)
            . TextAt(to_string(hops[i]), FS_TABLE, metric_color(hops[i], hops), TABLE_COLS[2], y, "r", 1.0)
            . TextAt(num1(costs[i]), FS_TABLE, metric_color(costs[i], costs), TABLE_COLS[3], y, "r", 1.0)
        }
    }
}


# =============================================================================
# MESH LEADERS (apenas os necessários; os slides reutilizam as mesmas camadas)
# =============================================================================

mesh title = []        # título do slide
mesh subtitle = []     # linha abaixo do título
mesh intro = []        # corpo da capa
mesh base = []         # arestas + círculos dos nós
mesh endpoints = []    # nós inicial e final
mesh labels = []       # números dos nós (cor muda ao serem explorados)
mesh region = []       # nós explorados
mesh trail = []        # árvore / trilha da busca
mesh cands = []        # sobreposição transitória (anéis, arestas candidatas, rótulos)
mesh pick = []         # nó destacado no passo
mesh path = []         # caminho (final, ou ramo ativo do DFS)
mesh panel = []        # painel lateral
mesh caption = []      # legenda / nota inferior
mesh table = []        # tabela comparativa


# =============================================================================
# SLIDES
# =============================================================================

slide "Introdução"
    title = to_side{UP, 0.5}
            center{ORIGIN}
            color{BLACK}
            stroke{BLACK, 0.75}
            Sans("Comparação de algoritmos de busca", FS_COVER_TITLE)

    subtitle = Subtitle(title, ["Dijkstra, A*, Hill Climbing, BFS, DFS"], BLACK, FS_COVER_SUB)
    play Write(1.2, [&title, &subtitle])

    let CoverBody = ||
        [
            center{[0, 0.65, 0]}
            color{BLACK} 
            Sans("em uma rede Pequeno Mundo", FS_COVER_BODY),
            
            center{[0, 0.3, 0]}
            color{BLACK}
            Typst("$(n=" + to_string(len(GRAPH_POINTS)) + ", thick K=" + to_string(SW_K) + ", thick p=" + to_string(SW_P) + ")$", FS_COVER_BODY - 0.05)
        ]

    intro = CoverBody()
    play Fade(0.8, [&intro])
        
    mesh authors = [    
        center{[0, -1, 0]}
        AuthorRows(AUTHORS, 2)
    ]
    
    play Fade(0.6, [&authors])
    play Wait(0.4)
    
    authors = []

slide "O grafo"
    title = []
    subtitle = []
    intro = []
    play Set()

    title = Title("Uma Rede Pequeno Mundo")
    subtitle = Subtitle(title,
                        ["cada nó se conecta aos seus " + to_string(SW_K) + " vizinhos mais próximos no plano"],
                        DARK_GRAY, FS_SUBTITLE)
    play Write(0.5, [&title, &subtitle])

    base = [GraphEdges(), AllNodes()]
    play Fade(0.6, [&base])

    endpoints = [Endpoint(START_ID, START_COLOR), Endpoint(GOAL_ID, GOAL_COLOR)]
    play Grow(0.4, [&endpoints])

    labels = NodeLabels([])
    panel = GraphInfoPanel()
    play Fade(0.5, [&labels, &panel])
    
    mesh start_node_caption_key =
        to_corner{DOWN + LEFT, 0.2}
        fill{START_COLOR} stroke{darken(START_COLOR), NODE_STROKE} Circle(0.04)
    
    mesh start_node_caption_label =
        next_to{start_node_caption_key} Sans("origem: nó " + to_string(START_ID), FS_CAPTION)
    
    mesh goal_node_caption_key =
        next_to{start_node_caption_label, 1r, 1}
        fill{GOAL_COLOR} stroke{darken(GOAL_COLOR), NODE_STROKE} Circle(0.04)
    
    mesh goal_node_caption_label = 
        next_to{goal_node_caption_key} Sans("destino: nó " + to_string(GOAL_ID), FS_CAPTION)
    
    caption = 
        [&start_node_caption_key, &start_node_caption_label, &goal_node_caption_key, &goal_node_caption_label]
    
    play [
        Write(0.6, [&caption])
    ]
    
    start_node_caption_key = []
    start_node_caption_label = []
    goal_node_caption_key = []
    goal_node_caption_label = []


# -----------------------------------------------------------------------------
# Slides dos algoritmos: mesmo esqueleto (limpa camadas -> título -> RunSearch ->
# caminho final + resumo)
# -----------------------------------------------------------------------------
slide "Dijkstra"
    title = []
    subtitle = []
    region = []
    trail = []
    cands = []
    pick = []
    path = []
    panel = []
    caption = []
    labels = NodeLabels([])
    play Set()

    title = Title("Dijkstra:  custo uniforme, expande por distância")
