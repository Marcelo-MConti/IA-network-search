# Animação da construção de uma rede Pequeno Mundo (Small World)
# Mostra: 1) vértices aleatórios, 2) grafo KNN, 3) reconexão (rewiring)
# Usa as mesmas constantes e funções de common.mcl/lib.mcl para consistência visual
#
# Para gerar os dados:
#     swipl -q -f scripts/generate_monocurl_graph_data.pl \
#         -g "run(20, 5, 0.15, 20, 11, 6, 'gen/graph20.mcl')" -t halt


import std.util
import std.math
import std.color
import std.mesh
import std.anim
import std.scene

import gen.graph20

import lib
import common


background = WHITE


# =============================================================================
# GRAFO
# =============================================================================

let graph = graph20 


# =============================================================================
# ANIMAÇÃO DE CONSTRUÇÃO (específica desta cena)
# =============================================================================

let HighlightNode = |graph, id, fill_col, stroke_col, stroke_w, r_mult|
    graph_embed(graph,
        tag{id}
        z_index{Z_HIGHLIGHT}
        fill{fill_col}
        stroke{stroke_col, stroke_w}
        center{node_local(graph, id)}
        Circle(NODE_R * r_mult))

let AnimateEdgesWithNodes = |graph, &edges_mesh, &highlight_mesh, edges_list, color, width, delay| anim {
    let node_dist = |a, b| norm(node_local(graph, a) - node_local(graph, b))

    var wave_edges = []
    var wave_highlights = []
    var current_source = -1
    var group_edges = []
    var group_highlights = []

    for (i in range(0, len(edges_list))) {
        let e = edges_list[i]

        if (current_source != -1 and e[0] != current_source) {
            # Try to put this K-edge group into the current parallel wave.
            # If it is too close to an edge already in that wave, flush first.
            var can_add = 1
            for (we in wave_edges) {
                for (ge in group_edges) {
                    if (node_dist(we[0], ge[0]) < 5.0 or node_dist(we[0], ge[1]) < 5.0 or node_dist(we[1], ge[0]) < 5.0 or node_dist(we[1], ge[1]) < 5.0) {
                        can_add = 0
                    }
                }
            }
            if (can_add == 0 and len(wave_edges) > 0) {
                for (we in wave_edges) {
                    edges_mesh = [edges_mesh, AnimEdge(graph, we[0], we[1], color, width)]
                }
                highlight_mesh = flatten(wave_highlights)
                play [
                    Grow(0.15, [&edges_mesh]),
                    Grow(0.1, [&highlight_mesh])
                ]
                play Wait(delay)
                highlight_mesh = []
                play Fade(0.1, [&highlight_mesh])
                wave_edges = []
                wave_highlights = []
            }
            for (ge in group_edges) {
                wave_edges .= ge
            }
            for (gh in group_highlights) {
                wave_highlights .= gh
            }
            group_edges = []
            group_highlights = []
        }

        current_source = e[0]
        group_edges .= e
        group_highlights .= [HighlightNode(graph, e[0], color, darken(color), 2, 1.3)]
        group_highlights .= [HighlightNode(graph, e[1], color, darken(color), 2, 1.3)]
    }

    # Finalize the last K-edge group.
    if (len(group_edges) > 0) {
        var can_add = 1
        for (we in wave_edges) {
            for (ge in group_edges) {
                if (node_dist(we[0], ge[0]) < 5.0 or node_dist(we[0], ge[1]) < 5.0 or node_dist(we[1], ge[0]) < 5.0 or node_dist(we[1], ge[1]) < 5.0) {
                    can_add = 0
                }
            }
        }
        if (can_add == 0 and len(wave_edges) > 0) {
            for (we in wave_edges) {
                edges_mesh = [edges_mesh, AnimEdge(graph, we[0], we[1], color, width)]
            }
            highlight_mesh = flatten(wave_highlights)
            play [
                Grow(0.15, [&edges_mesh]),
                Grow(0.1, [&highlight_mesh])
            ]
            play Wait(delay)
            highlight_mesh = []
            play Fade(0.1, [&highlight_mesh])
            wave_edges = []
            wave_highlights = []
        }
        for (ge in group_edges) {
            wave_edges .= ge
        }
        for (gh in group_highlights) {
            wave_highlights .= gh
        }
        group_edges = []
        group_highlights = []
    }

    # Flush the final parallel wave.
    if (len(wave_edges) > 0) {
        for (we in wave_edges) {
            edges_mesh = [edges_mesh, AnimEdge(graph, we[0], we[1], color, width)]
        }
        highlight_mesh = flatten(wave_highlights)
        play [
            Grow(0.15, [&edges_mesh]),
            Grow(0.1, [&highlight_mesh])
        ]
        play Wait(delay)
        highlight_mesh = []
        play Fade(0.1, [&highlight_mesh])
        wave_edges = []
        wave_highlights = []
    }
}

let AnimateRewiredEdges = |graph, &edges_mesh, &highlight_mesh, edges_list, delay| anim {
    var wave_edges = []
    var wave_highlights = []

    let node_dist = |a, b| norm(node_local(graph, a) - node_local(graph, b))

    for (i in range(0, len(edges_list))) {
        let e = edges_list[i]
        var can_add = 1
        for (we in wave_edges) {
            if (node_dist(we[0], e[0]) < 5.0 or node_dist(we[0], e[1]) < 5.0 or node_dist(we[1], e[0]) < 5.0 or node_dist(we[1], e[1]) < 5.0) {
                can_add = 0
            }
        }
        if (can_add == 0) {
            if (len(wave_edges) > 0) {
                for (fe in wave_edges) {
                    edges_mesh = [edges_mesh, graph_embed(graph, z_index{Z_EDGE} stroke{REWIRED_EDGE_COLOR, ANIM_EDGE_W} Line(node_local(graph, fe[0]), node_local(graph, fe[1])))]
                }
                highlight_mesh = flatten(wave_highlights)
                play [
                    Grow(0.2, [&highlight_mesh]),
                    Grow(0.1, [&edges_mesh])
                ]
                play Wait(delay)
                highlight_mesh = []
                play Fade(0.1, [&highlight_mesh])
                wave_edges = []
                wave_highlights = []
            }
        }
        wave_edges .= e
        wave_highlights .= [HighlightNode(graph, e[0], REWIRED_EDGE_COLOR, darken(REWIRED_EDGE_COLOR), 3, 1.5)]
        wave_highlights .= [HighlightNode(graph, e[1], REWIRED_EDGE_COLOR, darken(REWIRED_EDGE_COLOR), 3, 1.5)]
    }
    if (len(wave_edges) > 0) {
        for (fe in wave_edges) {
            edges_mesh = [edges_mesh, graph_embed(graph, z_index{Z_EDGE} stroke{REWIRED_EDGE_COLOR, ANIM_EDGE_W} Line(node_local(graph, fe[0]), node_local(graph, fe[1])))]
        }
        highlight_mesh = flatten(wave_highlights)
        play [
            Grow(0.2, [&highlight_mesh]),
            Grow(0.1, [&edges_mesh])
        ]
        play Wait(delay)
        highlight_mesh = []
        play Fade(0.1, [&highlight_mesh])
        wave_edges = []
        wave_highlights = []
    }
}

# =============================================================================
# MESH LEADERS
# =============================================================================

mesh title = []
mesh subtitle = []
mesh base_nodes = []
mesh endpoints = []
mesh knn_edges = []
mesh rewired_edges = []
mesh final_edges = []
mesh highlight = []
mesh labels = []
mesh caption = []
mesh panel = []


# =============================================================================
# SLIDES
# =============================================================================

slide "01 Construção da Rede Pequeno Mundo"
    title = Title("Construção de uma Rede Pequeno Mundo (Small World)")
    subtitle = Subtitle(title, ["N=20, K=5, p=0.15"], DARK_GRAY, FS_SUBTITLE)
    play Write(0.5, [&title, &subtitle])

    # --- Fase 1: Vértices aleatórios ---
    caption = Caption("Fase 1: " + to_string(len(graph["nodes"])) + " vértices posicionados aleatoriamente no plano")
    play Fade(0.3, [&caption])

    base_nodes = AllNodes(graph)
    labels = NodeLabels(graph, [])
    play [
        Grow(0.5, [&base_nodes]),
        Fade(0.3, [&labels])
    ]
    play Wait(0.5)

    # --- Fase 2: Grafo KNN ---
    caption = Caption("Fase 2: Cada nó conecta aos seus K=" + to_string(graph["k"]) + " vizinhos mais próximos (KNN)")
    play Fade(0.3, [&caption])

    play AnimateEdgesWithNodes(graph, &knn_edges, &highlight, graph["knn_edges"], KNN_EDGE_COLOR, ANIM_EDGE_W, 0.03)
    play Wait(0.5)

    # Mostra temporariamente apenas as arestas verdes e depois apenas as vermelhas.
    play Fade(0.3, [&knn_edges])

    # --- Fase 3: Reconexão (Rewiring) ---
    caption = Caption("Fase 3: Reconexão com probabilidade p=" + to_string(graph["p"]) + " (arestas vermelhas são reconectadas)")
    play Fade(0.3, [&caption])

    play AnimateRewiredEdges(graph, &rewired_edges, &highlight, graph["rewired_edges"], 0.04)
    play Wait(0.5)

    # --- Fase 4: Grafo final ---
    caption = Caption("Rede Pequeno Mundo final: estrutura local (KNN) + atalhos globais (rewiring)")
    play Fade(0.3, [&caption])

    #final_edges = GraphEdges(graph)
    play [
        Fade(0.3, [&knn_edges, &rewired_edges])#,
    #    Fade(0.5, [&final_edges])
    ]
    play Wait(0.5)

    panel = shift{[FRAME_W/2 - MARGIN - 1.4, -0.15, 0]} block {
        . z_index{Z_TEXT} fill{alpha{0.1} WHITE} stroke{DARK_GRAY, 1} Rect([2.8, 2.7])
        . TextAt("Parâmetros", FS_PANEL_HEAD, BLACK, 0, 0.95, "c", 2.6)
        . TextAt("N = " + to_string(len(graph["nodes"])) + " vértices", FS_PANEL_BODY, BLACK, -1.2, 0.5, "l", 2.4)
        . TextAt("K = " + to_string(graph["k"]) + " vizinhos", FS_PANEL_BODY, BLACK, -1.2, 0.2, "l", 2.4)
        . TextAt("p = " + to_string(graph["p"]) + " reconexão", FS_PANEL_BODY, BLACK, -1.2, -0.1, "l", 2.4)
        . TextAt("Estatísticas", FS_PANEL_HEAD, BLACK, 0, -0.43, "c", 2.6)
        . TextAt("Arestas KNN: " + to_string(len(graph["knn_edges"])), FS_PANEL_BODY, BLACK, -1.2, -0.76, "l", 2.4)
        . TextAt("Reconectadas: " + to_string(len(graph["rewired_edges"])), FS_PANEL_BODY, BLACK, -1.2, -1.0, "l", 2.4)
        . TextAt("Total: " + to_string(len(graph["edges"])), FS_PANEL_BODY, BLACK, -1.2, -1.24, "l", 2.4)
    }
    play Fade(0.5, [&panel])
    play Wait(1.0)

    caption = Footer("A rede Pequeno Mundo combina alta clusterização local com caminho médio curto")
    play Write(0.5, [&caption])
    play Wait(1.0)

slide "02 Posicionamento dos Vértices (mesmo layout da visualização)"
    title = []
    subtitle = []
    base_nodes = []
    endpoints = []
    knn_edges = []
    rewired_edges = []
    final_edges = []
    highlight = []
    labels = []
    caption = []
    panel = []
    play Fade(0.3, [&title, &subtitle, &base_nodes, &endpoints, &knn_edges, &rewired_edges, &final_edges, &highlight, &labels, &caption, &panel])

    title = Title("Layout dos Vértices (consistente com a visualização de busca)")
    subtitle = Subtitle(title, ["mesmo posicionamento usado nos slides de comparação de algoritmos"], DARK_GRAY, FS_SUBTITLE)
    play Write(0.5, [&title, &subtitle])

    base_nodes = AllNodes(graph)
    final_edges = GraphEdges(graph)
    labels = NodeLabels(graph, [])
    play [
        Grow(0.5, [&final_edges, &base_nodes]),
        Fade(0.3, [&labels])
    ]

    caption = Caption("Nós: " + to_string(len(graph["nodes"])) + "  |  Arestas: " + to_string(len(graph["edges"])) + "  |  K=" + to_string(graph["k"]) + "  |  p=" + to_string(graph["p"]))
    play Fade(0.3, [&caption])
    play Wait(1.0)

    print ["Nodes" -> len(graph["nodes"]), "KNN edges" -> len(graph["knn_edges"]), "Rewired edges" -> len(graph["rewired_edges"]), "Total edges" -> len(graph["edges"])]
